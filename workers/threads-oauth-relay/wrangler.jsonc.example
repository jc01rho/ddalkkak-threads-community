// wrangler.jsonc.example
// TEMPLATE입니다. 실제 배포 전에 "wrangler.jsonc"로 복사한 뒤 placeholder를 채우세요
// (실제 파일은 .gitignore에 있어 커밋되지 않습니다). 이 Phase(P0.3)에서는 "wrangler deploy"를
// 실행하지 않았습니다 - 코드와 테스트까지만 완료했습니다.
{
  "name": "REPLACE_ME-threads-oauth-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // ===== 로그/관측 설정(요청서 3절: code 노출 위험) =====
  // Workers Logs(observability)를 켜면 invocation 로그에 요청 URL이 포함될 수 있고, Meta callback의
  // URL query에는 authorization code가 실려 옵니다. 이 Worker는 console 로그에 code를 절대 남기지
  // 않지만, 플랫폼 수준의 URL 기록은 코드로 막을 수 없으므로 관측 기능을 명시적으로 끕니다.
  // Logpush/Tail Worker도 이 Worker에는 연결하지 마세요. 필요하면 관측 대신 /health만 외부 모니터링.
  "observability": { "enabled": false },

  // ===== KV binding: state → {status, code} 레코드(TTL 600초로 자동 폐기) =====
  // 생성: wrangler kv namespace create OAUTH_STATE_KV  → 출력된 id를 아래에 붙여넣기
  "kv_namespaces": [
    {
      "binding": "OAUTH_STATE_KV",
      "id": "REPLACE_ME-kv-namespace-id"
    }
  ],

  // ===== Rate Limiting binding(burst 남용 방지, best-effort) =====
  "unsafe": {
    "bindings": [
      {
        "name": "OAUTH_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1002",
        "simple": { "limit": 30, "period": 60 }
      }
    ]
  },

  // ===== secrets(절대 여기 값으로 적지 말 것 - wrangler secret put 으로만 등록) =====
  // wrangler secret put OAUTH_POLL_HMAC_SECRET   (예: openssl rand -base64 48 로 생성한 값)
  //
  // relay를 쓰는 앱이 자신을 증명하는 client key. 앱의 .env(THREADS_RELAY_CLIENT_KEY)와
  // media relay의 같은 이름 secret에 동일한 값을 넣습니다. 위 poll HMAC secret과는 용도가
  // 다르니 재사용하지 말고 별도로 생성하세요. 등록하지 않으면 모든 /oauth/start가 거부됩니다.
  // wrangler secret put THREADS_RELAY_CLIENT_KEY
  //
  // 이 Worker에는 Meta App Secret이 존재하지 않습니다. 구매자 자기 앱의 secret은 구매자 PC에만
  // 있고, code→token 교환은 그곳에서 일어납니다. 이 Worker는 code를 잠시 맡아 넘기는 역할뿐입니다.
}
