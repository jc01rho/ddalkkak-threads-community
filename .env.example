# 이 파일을 복사해서 .env 파일을 만드세요. (install.bat을 실행하면 자동으로 복사됩니다)
# .env 파일은 절대 Git에 올리지 마세요 (.gitignore에 이미 포함되어 있습니다).
# 설정 방법 안내: https://pulse-audio.co.kr/

# 웹 화면 포트
PORT=3970

# 시간대 (변경하지 마세요)
TZ=Asia/Seoul

# ===== 안전장치: 매우 중요 =====
# true 이면 실제로 Threads에 게시하지 않고, "발행 예정" 로그만 남깁니다.
# 실제로 게시하려면 아래 절차를 모두 마친 뒤 false로 바꾸세요. (README_KO.md 참고)
DRY_RUN=true

# ===== Meta 공식 Threads API 인증 정보 =====
# README_KO.md의 "Meta 개발자 앱 생성 절차"를 따라 발급받으세요.
# 절대 비밀번호, 세션 쿠키가 아닙니다. Threads User Access Token만 사용합니다.
THREADS_ACCESS_TOKEN=
# graph.threads.net/v1.0/me?fields=id,username 으로 확인한 사용자 ID
THREADS_USER_ID=

# 컨테이너 생성 후 발행까지 대기 시간(ms). 기본 30초(권장값).
THREADS_PUBLISH_WAIT_MS=30000

# 하루 최대 발행 수 (공식 API 제한인 250개보다 훨씬 낮게 운영)
DAILY_MAX_PUBLISH=6

# ===== 이미지/영상 실제 발행(Phase 12.5.4) =====
# 이 프로그램은 로컬 전용(127.0.0.1/::1)이라 Meta 서버가 로컬 파일에 직접 접근할 수 없습니다.
# 이미지/영상을 실제로 발행하려면 아래 두 값을 함께 설정해야 합니다. 비워두면 TEXT(텍스트만)
# 발행은 그대로 되고, IMAGE/VIDEO만 THREADS_MEDIA_PUBLIC_URL_REQUIRED로 명확히 실패합니다
# (텍스트로 조용히 대체되지 않습니다).
#
# 1) THREADS_MEDIA_GATEWAY_PORT: 아래 origin이 실제로 가리켜야 할 전용 포트. 이 포트는
#    /threads-media/:token 경로 "하나만" 제공합니다(대시보드/설정/DB API는 전혀 없음).
# 2) THREADS_MEDIA_PUBLIC_BASE_URL: 위 포트를 외부에서 접근 가능하게 만든 https:// origin
#    (직접 마련한 터널/리버스 프록시 등). 절대 딸깍 메인 PORT(위 PORT=3970)를 터널에 걸지
#    마세요 - 그러면 대시보드/DB API까지 함께 외부에 노출됩니다. 이 origin은 반드시
#    THREADS_MEDIA_GATEWAY_PORT 쪽을 가리켜야 합니다.
THREADS_MEDIA_GATEWAY_PORT=
THREADS_MEDIA_PUBLIC_BASE_URL=

# 미디어 게이트웨이가 발급하는 1회성 접근 URL의 유효 시간(ms). 기본 30분.
THREADS_MEDIA_TOKEN_TTL_MS=1800000

# ===== Production media relay(Phase 12.5.6C, 선택) =====
# 비워두면(기본값) 위 local gateway를 그대로 씁니다. 판매자가 별도로 배포한
# Cloudflare Worker relay(workers/threads-media-relay/)가 있다면 그 base URL(https://...)을
# 여기 설정하면 IMAGE/VIDEO/CAROUSEL 발행이 그 relay를 거칩니다. R2 access key/secret 등은
# 이 값에 필요하지 않습니다(전부 Worker 쪽에만 존재).
THREADS_MEDIA_RELAY_BASE_URL=

# 영상(VIDEO) 컨테이너 처리 상태 확인 간격/최대 횟수. 기본 1분 간격 최대 5회(공식 문서 권장).
THREADS_VIDEO_POLL_INTERVAL_MS=60000
THREADS_VIDEO_POLL_MAX_ATTEMPTS=5

# SQLite DB 파일 경로 (프로젝트 폴더 기준 상대경로)
DB_PATH=./data/app.db

# 테스트/개발 시 스케줄러(cron) 자동시작을 끄고 싶으면 true
DISABLE_SCHEDULER=false

# P0.5 BYO Threads OAuth: HTTPS code relay(workers/threads-oauth-relay) 공개 base URL (비밀 아님).
# release staging이 real .env 값을 주입합니다. 미설정이면 [Threads 계정 연결하기]가 동작하지 않습니다.
THREADS_OAUTH_RELAY_URL=

# 위 두 relay Worker에 접속할 때 자신을 증명하는 키(비밀). relay를 직접 배포한 사람이 정하고,
# Worker 쪽에도 같은 값을 등록합니다: wrangler secret put THREADS_RELAY_CLIENT_KEY
# 비워두면 미디어 발행과 [Threads 계정 연결하기]가 relay를 쓰지 못해 실패합니다.
THREADS_RELAY_CLIENT_KEY=
